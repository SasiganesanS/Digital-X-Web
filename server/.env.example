PORT=3001

# Primary Mail/PY REST API Engine
MAIL_API_URL=https://mail.prasklatechnology.com/api/send-email
MAIL_API_KEY=your_mail_api_key_here

# Fallback SMTP Engine Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Praskla Digital X

# Recipient Controls & Environment Mode
MARKETING_EMAIL=marketing@prasklatechnology.com
TEST_MODE=false
TEST_EMAIL=test@example.com

# Template Slugs
ADMIN_SLUG=digital X-admin
USER_SLUG=digital X- User
